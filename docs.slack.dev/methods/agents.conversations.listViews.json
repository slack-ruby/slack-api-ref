{
  "desc": "List the views currently attached to a code channel.",
  "scope": {
    "bot": [
      "code_channels:manage"
    ]
  },
  "json_input_supported": true,
  "rate_limits": {
    "apps_tier": "t3"
  },
  "args": {
    "type": "object",
    "required": [
      "token",
      "channel_id"
    ],
    "properties": {
      "token": {
        "desc": "Authentication token bearing the `code_channels:manage` scope. Must be a granular bot token.",
        "type": "string",
        "subtype": "auth",
        "example": "xxxx-xxxxxxxxx-xxxx"
      },
      "channel_id": {
        "desc": "ID of the code channel to list views for.",
        "type": "string",
        "subtype": "channel",
        "required_for_public": true
      }
    }
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "views"
    ],
    "properties": {
      "views": {
        "type": "array",
        "desc": "The agent views attached to the channel, in creation order.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "view_id",
            "view_key",
            "file_id",
            "label",
            "content_version",
            "date_added"
          ],
          "properties": {
            "view_id": {
              "type": "string",
              "desc": "The encoded channel tab ID of the view."
            },
            "view_key": {
              "type": "string",
              "desc": "The agent-assigned stable key of the view."
            },
            "file_id": {
              "type": "string",
              "desc": "The encoded ID of the backing HTML file."
            },
            "label": {
              "type": "string",
              "desc": "The display label of the view tab."
            },
            "content_version": {
              "type": "integer",
              "desc": "The current content version of the view."
            },
            "date_added": {
              "type": "integer",
              "desc": "Unix timestamp of when the view was first created."
            }
          }
        }
      }
    }
  },
  "errors": {
    "channel_not_found": {
      "desc": "The specified channel does not correspond to a valid channel."
    },
    "not_agent_channel": {
      "desc": "The specified channel is not a code channel."
    },
    "not_authorized": {
      "desc": "The caller is not an authorized agent bot or member for this channel."
    }
  },
  "examples": {
    "success": {
      "url": "/api/agents.conversations.listViews?token=YOUR_TOKEN",
      "description": "Typical success response",
      "example": {
        "ok": true,
        "views": [
          {
            "view_id": "T1234567890",
            "view_key": "reports/coverage.html",
            "file_id": "F1234567890",
            "label": "Coverage",
            "content_version": 3,
            "date_added": 1717171717
          },
          {
            "view_id": "T0987654321",
            "file_id": "F0987654321",
            "label": "Diff",
            "content_version": 5,
            "date_added": 1717171800
          },
          {
            "view_id": "T1111111111",
            "view_key": "plan",
            "file_id": "F1111111111",
            "label": "Plan",
            "content_version": 1,
            "date_added": 1717171900
          }
        ]
      }
    },
    "error": {
      "url": "/api/agents.conversations.listViews?token=YOUR_TOKEN",
      "description": "Typical error response",
      "example": {
        "ok": false,
        "error": "not_agent_channel"
      }
    }
  }
}