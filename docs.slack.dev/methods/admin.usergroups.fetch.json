{
  "desc": "Fetch an organizational usergroup.",
  "http_method": "POST",
  "scope": {
    "user": [
      "admin.usergroups:read"
    ]
  },
  "json_input_supported": true,
  "rate_limits": "t1",
  "args": {
    "type": "object",
    "required": [
      "token",
      "id"
    ],
    "properties": {
      "token": {
        "type": "string",
        "subtype": "auth",
        "desc": "Authentication token bearing required scopes. Tokens should be passed as an HTTP Authorization header or alternatively, as a POST parameter.",
        "example": "xxxx-xxxxxxxxx-xxxx"
      },
      "id": {
        "desc": "ID of the usergroup to fetch",
        "type": "string",
        "example": "S0604QSJC"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "subteam"
    ],
    "properties": {
      "subteam": {
        "schema": "subteam"
      }
    }
  },
  "errors": {
    "feature_not_enabled": {
      "desc": "The Admin APIs feature is not enabled for this workspace."
    },
    "invalid_auth": {
      "desc": "The workspace specified is not part of this organization."
    },
    "restricted_action": {
      "desc": "The calling user is not allowed to view the specified usergroup."
    },
    "not_an_enterprise": {
      "desc": "The token passed in does not belong to an Enterprise organization."
    },
    "invalid_usergroup": {
      "desc": "A usergroup with the specified ID does not exist."
    }
  },
  "examples": {
    "success": {
      "url": "/api/admin.usergroups.fetch?token=YOUR_TOKEN&id=S0604QSJC",
      "description": "Typical success response",
      "example": {
        "ok": true,
        "subteam": {
          "id": "S0604QSJC",
          "team_id": "E060RNRCZ",
          "enterprise_id": "E060RNRCZ",
          "is_subteam": true,
          "is_usergroup": true,
          "name": "Marketing Team",
          "description": "Marketing gurus, PR experts and product advocates.",
          "handle": "marketing-team",
          "is_external": false,
          "date_create": 1446746793,
          "date_update": 1446746793,
          "date_delete": 0,
          "auto_type": null,
          "auto_provision": false,
          "enterprise_subteam_id": "",
          "created_by": "U060R4BJ4",
          "updated_by": "U060R4BJ4",
          "deleted_by": null,
          "is_section": false,
          "is_editing_restricted": true,
          "is_membership_locked": true,
          "is_idp_group": false,
          "is_visible": true,
          "is_org_level": true,
          "teams": [
            "T060RNRCZ"
          ],
          "user_count": 2,
          "channel_count": 1
        }
      }
    },
    "error": {
      "url": "/api/admin.usergroups.fetch?token=YOUR_TOKEN&id=S0604RSK9",
      "description": "Typical error response if no usergroup exists with the specified ID",
      "example": {
        "ok": false,
        "error": "invalid_usergroup"
      }
    }
  }
}